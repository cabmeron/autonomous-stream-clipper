# ==============================================================================
# Autonomous Twitch Stream Clipper - 100% Local Configuration
# ==============================================================================

# Target Twitch Channel (Empty on startup; configured dynamically from Web UI)
TWITCH_CHANNEL=

# Local Media Storage Directory (Served at http://localhost:8000/clips/)
STORAGE_DIR=./storage/clips

# Database Configuration (Defaults to embedded SQLite at ./storage/clipper.db)
DATABASE_URL=

# Heuristic Trigger Thresholds
HEURISTIC_CHAT_RATIO_THRESHOLD=3.0
HEURISTIC_CHAT_INSTANT_MIN=10.0
HEURISTIC_WIN_MULTIPLIER_THRESHOLD=100.0
HEURISTIC_AUDIO_DB_THRESHOLD=12.0
HEURISTIC_DEBOUNCE_SECONDS=90
POST_EVENT_DELAY_SECONDS=15

# OCR Region of Interest (Normalized coordinates: 0.0 to 1.0)
OCR_ENABLED=true
OCR_ROI_X=0.70
OCR_ROI_Y=0.85
OCR_ROI_W=0.28
OCR_ROI_H=0.12

# Video Rendering Configuration (auto, videotoolbox, nvenc, or libx264)
VIDEO_ENCODER=auto
ENABLE_BURN_IN_SUBS=true

# Local Ports
HTTP_PORT=8000
TELEMETRY_PORT=8765
